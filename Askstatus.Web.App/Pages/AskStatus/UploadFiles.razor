@page "/admin/system/upload-files"
@attribute [Authorize(Permissions.System)]

<PageTitle>Askstatus - Upload files</PageTitle>
<MudStack>
    <MudFileUpload T="IBrowserFile" 
                   FilesChanged="UploadGoogleFile" 
                   Accept="gmail.com"
                   id="googleFileInput"
                   Hidden="true" />
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.CloudUpload"
               HtmlTag="label"
               for="googleFileInput">
        Upload Google Token Response File
    </MudButton>

    <MudFileUpload T="IBrowserFile" 
                   FilesChanged="UploadAppSettingsFile" 
                   Accept="appsettings.Production.json"
                   id="appSettingsFileInput"
                   Hidden="true" />
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.CloudUpload"
               HtmlTag="label"
               for="appSettingsFileInput">
        Upload Production AppSettings File
    </MudButton>
</MudStack>